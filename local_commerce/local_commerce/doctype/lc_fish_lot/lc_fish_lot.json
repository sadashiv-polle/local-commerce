    },
    {
      "fieldname": "item",
      "label": "Fish",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "warehouse",
      "label": "Warehouse",
      "fieldtype": "Link",
