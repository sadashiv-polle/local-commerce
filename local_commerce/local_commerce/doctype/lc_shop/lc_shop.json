{
  "doctype": "DocType",
  "name": "LC Shop",
  "module": "Local Commerce",
  "engine": "InnoDB",
  "custom": 0,
  "track_changes": 1,
  "field_order": [
    "shop_name",
    "company",
    "company_country",
    "company_currency",
    "shop_type",
    "status",
    "description",
    "order_response_minutes",
    "accepting_orders",
    "opening_hours_json",
    "location_section",
    "address_line1",
    "city",
    "postal_code",
    "location_map",
    "latitude",
    "longitude",
    "service_radius_km",
    "live_tracking_enabled",
    "inventory_section",
    "warehouse",
    "stock_adjustment_account",
    "fish_wastage_account",
    "cost_center",
    "selling_price_list",
    "delivery_section",
    "delivery_enabled",
    "delivery_fee",
    "minimum_order_amount",
    "free_delivery_above",
    "delivery_fee_per_km",
    "delivery_included_km",
    "delivery_account",
    "order_tax_template",
    "payment_section",
    "cod_enabled",
    "cod_cash_account",
    "cod_mode_of_payment",
    "scheduled_enabled",
    "upi_section",
    "upi_enabled",
    "upi_id",
    "upi_qr",
    "upi_bank_account",
    "upi_mode_of_payment"
  ],
  "fields": [
    {
      "fieldname": "shop_name",
      "label": "Shop Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "unique": 1,
      "description": "Leave blank to create a Company with the Shop Name when saving. Select an existing Company only to link it explicitly."
    },
    {
      "fieldname": "company_country",
      "label": "New Company Country",
      "fieldtype": "Link",
      "options": "Country",
      "depends_on": "eval:doc.__islocal && !doc.company",
      "description": "Uses the site country if left blank."
    },
    {
      "fieldname": "company_currency",
      "label": "New Company Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "depends_on": "eval:doc.__islocal && !doc.company",
      "description": "Uses the site currency if left blank."
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nActive\nTemporarily Closed\nDisabled",
      "default": "Draft",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "order_response_minutes",
      "label": "Order Response Time (minutes)",
      "fieldtype": "Int",
      "default": "10",
      "reqd": 1,
      "description": "Unanswered orders are cancelled automatically after this time."
    },
    {
      "fieldname": "accepting_orders",
      "label": "Accept New Orders",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "opening_hours_json",
      "label": "Weekly Opening Hours",
      "fieldtype": "Long Text",
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "location_section",
      "label": "Shop location and service area",
      "fieldtype": "Section Break",
      "permlevel": 1
    },
    {
      "fieldname": "address_line1",
      "label": "Shop Address",
      "fieldtype": "Data",
      "permlevel": 1
    },
    {
      "fieldname": "city",
      "label": "City",
      "fieldtype": "Data",
      "permlevel": 1
    },
    {
      "fieldname": "postal_code",
      "label": "Shop Postal Code",
      "fieldtype": "Data",
      "permlevel": 1
    },
    {
      "fieldname": "latitude",
      "label": "Latitude",
      "fieldtype": "Float",
      "precision": 6,
      "permlevel": 1
    },
    {
      "fieldname": "longitude",
      "label": "Longitude",
      "fieldtype": "Float",
      "precision": 6,
      "permlevel": 1
    },
    {
      "fieldname": "service_radius_km",
      "label": "Delivery Radius (km)",
      "fieldtype": "Float",
      "default": "5",
      "permlevel": 1
    },
    {
      "fieldname": "live_tracking_enabled",
      "label": "Enable Live Delivery Tracking",
      "fieldtype": "Check",
      "default": "1",
      "permlevel": 1
    },
    {
      "fieldname": "inventory_section",
      "label": "Inventory and pricing",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "warehouse",
      "label": "Default Warehouse",
      "fieldtype": "Link",
      "options": "Warehouse"
    },
    {
      "fieldname": "stock_adjustment_account",
      "label": "Stock Adjustment Account",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "cost_center",
      "label": "Cost Center",
      "fieldtype": "Link",
      "options": "Cost Center"
    },
    {
      "fieldname": "selling_price_list",
      "label": "Selling Price List",
      "fieldtype": "Link",
      "options": "Price List",
      "read_only": 1,
      "unique": 1
    },
    {
      "fieldname": "delivery_section",
      "label": "Customer delivery requests",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "delivery_enabled",
      "label": "Enable Delivery Requests",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "delivery_fee",
      "label": "Delivery Fee",
      "fieldtype": "Currency",
      "default": "0"
    },
    {
      "fieldname": "delivery_account",
      "label": "Delivery Charge Account",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "order_tax_template",
      "label": "Order Tax Template",
      "fieldtype": "Link",
      "options": "Sales Taxes and Charges Template",
      "description": "Optional. Select a template from this Company when ERPNext should calculate taxes for customer orders."
    },
    {
      "fieldname": "payment_section",
      "label": "Cash on delivery",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "cod_enabled",
      "label": "Enable Cash on Delivery",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "cod_cash_account",
      "label": "Cash Collection Account",
      "fieldtype": "Link",
      "options": "Account",
      "description": "Submitted rider collections are posted to this Company cash account."
    },
    {
      "fieldname": "cod_mode_of_payment",
      "label": "Cash Mode of Payment",
      "fieldtype": "Link",
      "options": "Mode of Payment"
    },
    {
      "fieldname": "minimum_order_amount",
      "label": "Minimum Order Amount",
      "fieldtype": "Currency",
      "default": "0"
    },
    {
      "fieldname": "free_delivery_above",
      "label": "Free Delivery Above",
      "fieldtype": "Currency",
      "default": "0"
    },
    {
      "fieldname": "delivery_fee_per_km",
      "label": "Delivery Fee per Additional km",
      "fieldtype": "Currency",
      "default": "0"
    },
    {
      "fieldname": "delivery_included_km",
      "label": "Distance Included in Base Fee (km)",
      "fieldtype": "Float",
      "default": "0"
    },
    {
      "fieldname": "shop_type",
      "label": "Shop type",
      "fieldtype": "Select",
      "options": "General\nFish",
      "default": "General"
    },
    {
      "fieldname": "fish_wastage_account",
      "label": "Fish wastage expense account",
      "fieldtype": "Link",
      "options": "Account",
      "depends_on": "eval:doc.shop_type == \"Fish\""
    },
    {
      "fieldname": "location_map",
      "label": "Shop Map Pin",
      "fieldtype": "Geolocation",
      "description": "Admin only: use the marker tool to place one shop pin. Save to store its latitude and longitude. Move or remove the existing marker before adding another."
    },
    {
      "fieldname": "scheduled_enabled",
      "label": "Enable Scheduled Delivery",
      "fieldtype": "Check",
      "default": "0",
      "permlevel": 1
    },
    {
      "fieldname": "upi_section",
      "label": "Manual UPI",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "upi_enabled",
      "label": "Enable manual UPI",
      "fieldtype": "Check"
    },
    {
      "fieldname": "upi_id",
      "label": "UPI ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "upi_qr",
      "label": "UPI QR image",
      "fieldtype": "Attach Image"
    },
    {
      "fieldname": "upi_bank_account",
      "label": "UPI receiving bank account",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "upi_mode_of_payment",
      "label": "UPI mode of payment",
      "fieldtype": "Link",
      "options": "Mode of Payment"
    }
  ],
  "permissions": [
    {
      "role": "LC Platform Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "LC Platform Administrator",
      "permlevel": 1,
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "LC Shop Owner",
      "read": 1,
      "write": 1
    },
    {
      "role": "LC Shop Staff",
      "read": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "hash",
  "title_field": "shop_name",
  "show_title_field_in_link": 1
}
