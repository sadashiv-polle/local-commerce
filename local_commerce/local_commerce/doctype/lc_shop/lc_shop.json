{
  "doctype": "DocType",
  "name": "LC Shop",
  "module": "Local Commerce",
  "engine": "InnoDB",
  "custom": 0,
  "track_changes": 1,
  "field_order": [
    "shop_name",
    "company",
    "company_country",
    "company_currency",
    "status",
    "description",
    "location_section",
    "address_line1",
    "city",
    "postal_code",
    "latitude",
    "longitude",
    "service_radius_km",
    "live_tracking_enabled",
    "inventory_section",
    "warehouse",
    "stock_adjustment_account",
    "cost_center",
    "selling_price_list",
    "delivery_section",
    "delivery_enabled",
    "delivery_postcodes",
    "delivery_fee",
    "delivery_account",
    "order_tax_template",
    "payment_section",
    "cod_enabled",
    "cod_cash_account",
    "cod_mode_of_payment"
  ],
  "fields": [
    {
      "fieldname": "shop_name",
      "label": "Shop Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "unique": 1,
      "description": "Leave blank to create a Company with the Shop Name when saving. Select an existing Company only to link it explicitly."
    },
    {
      "fieldname": "company_country",
      "label": "New Company Country",
      "fieldtype": "Link",
      "options": "Country",
      "depends_on": "eval:doc.__islocal && !doc.company",
      "description": "Uses the site country if left blank."
    },
    {
      "fieldname": "company_currency",
      "label": "New Company Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "depends_on": "eval:doc.__islocal && !doc.company",
      "description": "Uses the site currency if left blank."
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nActive\nTemporarily Closed\nDisabled",
      "default": "Draft",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "description",
      "label": "Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "location_section",
      "label": "Shop location and service area",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "address_line1",
      "label": "Shop Address",
      "fieldtype": "Data"
    },
    {
      "fieldname": "city",
      "label": "City",
      "fieldtype": "Data"
    },
    {
      "fieldname": "postal_code",
      "label": "Shop Postal Code",
      "fieldtype": "Data"
    },
    {
      "fieldname": "latitude",
      "label": "Latitude",
      "fieldtype": "Float",
      "precision": 6
    },
    {
      "fieldname": "longitude",
      "label": "Longitude",
      "fieldtype": "Float",
      "precision": 6
    },
    {
      "fieldname": "service_radius_km",
      "label": "Delivery Radius (km)",
      "fieldtype": "Float",
      "default": "5"
    },
    {
      "fieldname": "live_tracking_enabled",
      "label": "Enable Live Delivery Tracking",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "inventory_section",
      "label": "Inventory and pricing",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "warehouse",
      "label": "Default Warehouse",
      "fieldtype": "Link",
      "options": "Warehouse"
    },
    {
      "fieldname": "stock_adjustment_account",
      "label": "Stock Adjustment Account",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "cost_center",
      "label": "Cost Center",
      "fieldtype": "Link",
      "options": "Cost Center"
    },
    {
      "fieldname": "selling_price_list",
      "label": "Selling Price List",
      "fieldtype": "Link",
      "options": "Price List",
      "read_only": 1,
      "unique": 1
    },
    {
      "fieldname": "delivery_section",
      "label": "Customer delivery requests",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "delivery_enabled",
      "label": "Enable Delivery Requests",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "delivery_postcodes",
      "label": "Delivery Postal Codes",
      "fieldtype": "Small Text",
      "description": "One postal code per line. Exact matches only."
    },
    {
      "fieldname": "delivery_fee",
      "label": "Delivery Fee",
      "fieldtype": "Currency",
      "default": "0"
    },
    {
      "fieldname": "delivery_account",
      "label": "Delivery Charge Account",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "order_tax_template",
      "label": "Order Tax Template",
      "fieldtype": "Link",
      "options": "Sales Taxes and Charges Template",
      "description": "ERPNext calculates taxes. Required when enabling delivery; use an explicitly configured zero-tax template if applicable."
    },
    {
      "fieldname": "payment_section",
      "label": "Cash on delivery",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "cod_enabled",
      "label": "Enable Cash on Delivery",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "cod_cash_account",
      "label": "Cash Collection Account",
      "fieldtype": "Link",
      "options": "Account",
      "description": "Submitted rider collections are posted to this Company cash account."
    },
    {
      "fieldname": "cod_mode_of_payment",
      "label": "Cash Mode of Payment",
      "fieldtype": "Link",
      "options": "Mode of Payment"
    }
  ],
  "permissions": [
    {
      "role": "LC Platform Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "LC Shop Owner",
      "read": 1,
      "write": 1
    },
    {
      "role": "LC Shop Staff",
      "read": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "autoname": "hash",
  "title_field": "shop_name"
}
