      "unique": 1,
      "reqd": 1,
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "shop",
      "label": "Shop",
      "fieldtype": "Link",
      "options": "LC Shop",
      "reqd": 1,
      "read_only": 1,
      "search_index": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "delivery_user",
      "label": "Delivery Person",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "read_only": 1,
      "search_index": 1
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "expected_amount",
      "label": "Expected Amount",
      "fieldtype": "Currency",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "collected_amount",
      "label": "Collected Amount",
      "fieldtype": "Currency",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "variance",
      "label": "Variance",
      "fieldtype": "Currency",
      "reqd": 1,
      "read_only": 1
    },
    {
