{
  "doctype": "DocType",
  "name": "LC COD Collection",
  "module": "Local Commerce",
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "title_field": "order",
  "field_order": [
    "order",
    "shop",
    "delivery_user",
    "currency",
    "expected_amount",
    "collected_amount",
    "variance",
    "status",
    "collected_at",
    "driver_note",
    "reconciled_by",
    "reconciled_at",
    "owner_note"
  ],
  "fields": [
