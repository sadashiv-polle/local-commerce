    {
      "fieldname": "collected_at",
      "label": "Collected At",
      "fieldtype": "Datetime",
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "driver_note",
      "label": "Driver Note",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "reconciled_by",
      "label": "Reconciled By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "reconciled_at",
      "label": "Reconciled At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "owner_note",
      "label": "Owner Note",
      "fieldtype": "Small Text",
      "read_only": 1
    }
