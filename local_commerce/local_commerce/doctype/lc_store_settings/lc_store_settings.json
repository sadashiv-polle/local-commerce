{
  "doctype": "DocType",
  "name": "LC Store Settings",
  "module": "Local Commerce",
  "issingle": 1,
  "field_order": [
    "enabled",
    "mode",
    "title",
    "random_count",
    "products",
    "category_section",
    "category_menu_enabled",
    "category_menu_initialized",
    "categories"
  ],
  "fields": [
    {
      "fieldname": "enabled",
      "label": "Show on Public Store",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "mode",
      "label": "Featured Products",
      "fieldtype": "Select",
      "options": "Disabled\nSelected\nRandom",
      "default": "Disabled",
      "reqd": 1
    },
    {
      "fieldname": "title",
      "label": "Section Title",
      "fieldtype": "Data",
      "default": "Picked for you"
    },
    {
      "fieldname": "random_count",
      "label": "Random Product Count",
      "fieldtype": "Int",
      "default": 6
    },
    {
      "fieldname": "products",
      "label": "Selected Products",
      "fieldtype": "Table",
      "options": "LC Featured Product"
    },
    {
      "fieldname": "category_section",
      "label": "Category Menu",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "category_menu_enabled",
      "label": "Show Category Menu",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "category_menu_initialized",
      "label": "Category Menu Initialized",
      "fieldtype": "Check",
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "categories",
      "label": "Categories",
      "fieldtype": "Table",
      "options": "LC Store Category"
    }
  ],
  "permissions": [
    {
      "role": "LC Platform Administrator",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
