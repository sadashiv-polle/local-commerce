{
  "doctype": "DocType",
  "name": "LC Store Settings",
  "module": "Local Commerce",
  "issingle": 1,
  "field_order": [
    "enabled",
    "mode",
    "title",
    "random_count",
    "products",
    "category_section",
    "category_menu_enabled",
    "category_menu_initialized",
    "categories",
    "promotions_json",
    "pinned_shop",
    "app_favicon",
    "gst_section",
    "gst_company",
    "gst_legal_name",
    "gst_number",
    "gst_state",
    "gst_address",
    "gst_sac",
    "gst_rate",
    "gst_cost_center",
    "gst_clearing",
    "gst_receivable",
    "gst_income",
    "gst_cgst",
    "gst_sgst",
    "gst_igst",
    "gst_eco_cgst",
    "gst_eco_sgst",
    "gst_eco_igst",
    "gst_bank",
    "gst_fee",
    "gst_fee_tax",
    "setup_section",
    "marketplace_name",
    "setup_shop",
    "setup_complete",
    "setup_pending",
    "setup_message",
    "setup_vendor_payable"
  ],
  "fields": [
    {
      "fieldname": "enabled",
      "label": "Show on Public Store",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "mode",
      "label": "Featured Products",
      "fieldtype": "Select",
      "options": "Disabled\nSelected\nRandom",
      "default": "Disabled",
      "reqd": 1
    },
    {
      "fieldname": "title",
      "label": "Section Title",
      "fieldtype": "Data",
      "default": "Picked for you"
    },
    {
      "fieldname": "random_count",
      "label": "Random Product Count",
      "fieldtype": "Int",
      "default": 6
    },
    {
      "fieldname": "products",
      "label": "Selected Products",
      "fieldtype": "Table",
      "options": "LC Featured Product"
    },
    {
      "fieldname": "category_section",
      "label": "Category Menu",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "category_menu_enabled",
      "label": "Show Category Menu",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "category_menu_initialized",
      "label": "Category Menu Initialized",
      "fieldtype": "Check",
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "categories",
      "label": "Categories",
      "fieldtype": "Table",
      "options": "LC Store Category"
    },
    {
      "fieldname": "promotions_json",
      "label": "Homepage promotions",
      "fieldtype": "Code",
      "options": "JSON",
      "hidden": 1
    },
    {
      "fieldname": "pinned_shop",
      "label": "Show This Shop First",
      "fieldtype": "Link",
      "options": "LC Shop"
    },
    {
      "fieldname": "app_favicon",
      "label": "App Favicon",
      "fieldtype": "Attach Image",
      "read_only": 1
    },
    {
      "fieldname": "gst_section",
      "label": "Platform GST",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "gst_company",
      "label": "Platform Company",
      "fieldtype": "Link",
      "options": "Company"
    },
    {
      "fieldname": "gst_legal_name",
      "label": "Platform legal name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "gst_number",
      "label": "Platform GSTIN",
      "fieldtype": "Data"
    },
    {
      "fieldname": "gst_state",
      "label": "Platform state code",
      "fieldtype": "Data"
    },
    {
      "fieldname": "gst_address",
      "label": "Platform billing address",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "gst_sac",
      "label": "Commission SAC",
      "fieldtype": "Data",
      "default": ""
    },
    {
      "fieldname": "gst_rate",
      "label": "Commission GST percent",
      "fieldtype": "Percent",
      "default": "18"
    },
    {
      "fieldname": "gst_cost_center",
      "label": "Platform cost center",
      "fieldtype": "Link",
      "options": "Cost Center"
    },
    {
      "fieldname": "gst_clearing",
      "label": "Gateway retained-funds clearing",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_receivable",
      "label": "Amounts due from shops",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_income",
      "label": "Commission income",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_cgst",
      "label": "Commission CGST payable",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_sgst",
      "label": "Commission SGST payable",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_igst",
      "label": "Commission IGST payable",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_eco_cgst",
      "label": "Section 9(5) CGST payable",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_eco_sgst",
      "label": "Section 9(5) SGST payable",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_eco_igst",
      "label": "Section 9(5) IGST payable",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_bank",
      "label": "Platform bank",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_fee",
      "label": "Gateway and Easy Split expense",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "gst_fee_tax",
      "label": "Gateway fee GST expense",
      "fieldtype": "Link",
      "options": "Account"
    },
    {
      "fieldname": "setup_section",
      "fieldtype": "Section Break",
      "label": "Local dot Setup"
    },
    {
      "fieldname": "marketplace_name",
      "fieldtype": "Data",
      "label": "Marketplace name"
    },
    {
      "fieldname": "setup_shop",
      "fieldtype": "Link",
      "label": "Default owned shop",
      "options": "LC Shop",
      "read_only": 1
    },
    {
      "fieldname": "setup_complete",
      "fieldtype": "Check",
      "label": "Basic structure initialized",
      "read_only": 1
    },
    {
      "fieldname": "setup_pending",
      "fieldtype": "Check",
      "label": "Installation setup pending",
      "read_only": 1
    },
    {
      "fieldname": "setup_message",
      "fieldtype": "Small Text",
      "label": "Setup status",
      "read_only": 1
    },
    {
      "fieldname": "setup_vendor_payable",
      "fieldtype": "Link",
      "label": "Vendor settlement liability",
      "options": "Account",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "LC Platform Administrator",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
