{
  "doctype": "DocType",
  "name": "LC Product List",
  "module": "Local Commerce",
  "issingle": 0,
  "field_order": [
    "enabled",
    "mode",
    "title",
    "random_count",
    "products"
  ],
  "fields": [
    {
      "fieldname": "enabled",
      "label": "Show on Public Store",
      "fieldtype": "Check",
      "default": 1
    },
    {
      "fieldname": "mode",
      "label": "Featured Products",
      "fieldtype": "Select",
      "options": "Disabled\nSelected\nRandom",
      "default": "Disabled",
      "reqd": 1
    },
    {
      "fieldname": "title",
      "label": "Section Title",
      "fieldtype": "Data",
      "default": "Picked for you"
    },
    {
      "fieldname": "random_count",
      "label": "Random Product Count",
      "fieldtype": "Int",
      "default": 6
    },
    {
      "fieldname": "products",
      "label": "Selected Products",
      "fieldtype": "Table",
      "options": "LC Featured Product"
    }
  ],
  "permissions": [
    {
      "role": "LC Platform Administrator",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "autoname": "hash",
  "title_field": "title"
}
