{
  "doctype": "DocType",
  "name": "LC Order",
  "module": "Local Commerce",
  "engine": "InnoDB",
  "autoname": "field:request_key",
  "track_changes": 1,
  "field_order": [
    "request_key",
    "shop",
    "customer_user",
    "sales_order",
    "request_hash",
    "selling_lines_json",
    "status",
    "delivery_user",
    "delivery_note",
    "assigned_at",
    "picked_up_at",
    "delivered_at",
    "payment_method",
    "payment_status",
    "sales_invoice",
    "payment_entry",
    "collected_at",
    "recipient",
    "phone",
    "address_snapshot",
    "destination_latitude",
    "destination_longitude",
    "delivery_distance_km",
    "delivery_instructions",
    "driver_latitude",
    "driver_longitude",
    "driver_location_accuracy",
    "driver_location_at",
    "reason",
    "fish_allocations_json",
    "delivery_mode",
    "scheduled_slot",
    "upi_id",
    "upi_qr",
    "upi_bank_account",
    "upi_mode_of_payment",
    "upi_proof",
    "upi_reference",
    "upi_review_note",
    "upi_verified_by",
    "upi_verified_at",
    "upi_receipt_key"
  ],
  "fields": [
    {
      "fieldname": "selling_lines_json",
      "label": "Selling Option Snapshots",
      "fieldtype": "Long Text",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "request_key",
      "label": "Request Key",
      "fieldtype": "Data",
      "unique": 1,
      "read_only": 1
    },
    {
      "fieldname": "shop",
      "label": "Shop",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "LC Shop",
      "in_list_view": 1
    },
    {
      "fieldname": "customer_user",
      "label": "Customer User",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "User"
    },
    {
      "fieldname": "sales_order",
      "label": "Sales Order",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Sales Order"
    },
    {
      "fieldname": "request_hash",
      "label": "Request Hash",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "read_only": 1,
      "options": "Requested\nAccepted\nPreparing\nReady\nPicked Up\nOut for Delivery\nDelivered\nCancelled",
      "in_list_view": 1
    },
    {
      "fieldname": "delivery_user",
      "label": "Delivery Person",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "delivery_note",
      "label": "Delivery Note",
      "fieldtype": "Link",
      "options": "Delivery Note",
      "read_only": 1
    },
    {
      "fieldname": "assigned_at",
      "label": "Assigned At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "picked_up_at",
      "label": "Picked Up At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "delivered_at",
      "label": "Delivered At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "payment_method",
      "label": "Payment Method",
      "fieldtype": "Select",
      "options": "Cash on Delivery\nManual UPI",
      "read_only": 1
    },
    {
      "fieldname": "payment_status",
      "label": "Payment Status",
      "fieldtype": "Select",
      "options": "Pending\nCollected\nReconciled\nAwaiting Verification\nPayment Rejected\nPaid",
      "read_only": 1
    },
    {
      "fieldname": "sales_invoice",
      "label": "Sales Invoice",
      "fieldtype": "Link",
      "options": "Sales Invoice",
      "read_only": 1
    },
    {
      "fieldname": "payment_entry",
      "label": "Payment Entry",
      "fieldtype": "Link",
      "options": "Payment Entry",
      "read_only": 1
    },
    {
      "fieldname": "collected_at",
      "label": "Collected At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "recipient",
      "label": "Recipient",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "phone",
      "label": "Phone",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "address_snapshot",
      "label": "Address Snapshot",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "destination_latitude",
      "label": "Destination Latitude",
      "fieldtype": "Float",
      "precision": 6,
      "read_only": 1
    },
    {
      "fieldname": "destination_longitude",
      "label": "Destination Longitude",
      "fieldtype": "Float",
      "precision": 6,
      "read_only": 1
    },
    {
      "fieldname": "delivery_distance_km",
      "label": "Straight-line Delivery Distance (km)",
      "fieldtype": "Float",
      "precision": 3,
      "read_only": 1
    },
    {
      "fieldname": "delivery_instructions",
      "label": "Delivery Instructions",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "driver_latitude",
      "label": "Current Delivery Person Latitude",
      "fieldtype": "Float",
      "precision": 6,
      "read_only": 1
    },
    {
      "fieldname": "driver_longitude",
      "label": "Current Delivery Person Longitude",
      "fieldtype": "Float",
      "precision": 6,
      "read_only": 1
    },
    {
      "fieldname": "driver_location_accuracy",
      "label": "Delivery Person Location Accuracy (m)",
      "fieldtype": "Float",
      "read_only": 1
    },
    {
      "fieldname": "driver_location_at",
      "label": "Delivery Person Location At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "reason",
      "label": "Reason",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "fish_allocations_json",
      "label": "Fish stock allocation",
      "fieldtype": "Long Text",
      "hidden": 1,
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "delivery_mode",
      "label": "Delivery booking",
      "fieldtype": "Select",
      "options": "Normal\nScheduled",
      "default": "Normal",
      "read_only": 1
    },
    {
      "fieldname": "scheduled_slot",
      "label": "Scheduled delivery batch",
      "fieldtype": "Link",
      "options": "LC Delivery Slot",
      "read_only": 1
    },
    {
      "fieldname": "upi_id",
      "label": "Payee UPI ID",
      "fieldtype": "Data",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "upi_qr",
      "label": "Payee QR image",
      "fieldtype": "Attach Image",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "upi_bank_account",
      "label": "UPI bank account",
      "fieldtype": "Link",
      "options": "Account",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "upi_mode_of_payment",
      "label": "UPI mode",
      "fieldtype": "Link",
      "options": "Mode of Payment",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "upi_proof",
      "label": "Payment screenshot",
      "fieldtype": "Attach Image",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "upi_reference",
      "label": "Verified transaction reference",
      "fieldtype": "Data",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "upi_review_note",
      "label": "Payment review note",
      "fieldtype": "Small Text",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "upi_verified_by",
      "label": "Payment verified by",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "upi_verified_at",
      "label": "Payment verified at",
      "fieldtype": "Datetime",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "upi_receipt_key",
      "label": "UPI receipt key",
      "fieldtype": "Data",
      "unique": 1,
      "hidden": 1,
      "read_only": 1,
      "no_copy": 1
    }
  ],
  "permissions": [
    {
      "role": "LC Platform Administrator",
      "read": 1
    },
    {
      "role": "LC Shop Owner",
      "read": 1
    },
    {
      "role": "LC Shop Staff",
      "read": 1
    },
    {
      "role": "LC Customer",
      "read": 1
    }
  ]
}
