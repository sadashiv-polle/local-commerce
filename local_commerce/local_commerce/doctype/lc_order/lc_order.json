{
  "doctype": "DocType",
  "name": "LC Order",
  "module": "Local Commerce",
  "engine": "InnoDB",
  "autoname": "field:request_key",
  "track_changes": 1,
  "field_order": [
    "request_key",
    "shop",
    "customer_user",
    "sales_order",
    "request_hash",
    "status",
    "recipient",
    "phone",
    "address_snapshot",
    "reason"
  ],
  "fields": [
    {
      "fieldname": "request_key",
      "label": "Request Key",
      "fieldtype": "Data",
      "unique": 1,
      "read_only": 1
    },
    {
      "fieldname": "shop",
      "label": "Shop",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "LC Shop",
      "in_list_view": 1
    },
    {
      "fieldname": "customer_user",
      "label": "Customer User",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "User"
    },
    {
      "fieldname": "sales_order",
      "label": "Sales Order",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Sales Order"
    },
    {
      "fieldname": "request_hash",
      "label": "Request Hash",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "read_only": 1,
      "options": "Requested\nAccepted\nPreparing\nReady\nCancelled",
      "in_list_view": 1
    },
    {
      "fieldname": "recipient",
      "label": "Recipient",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "phone",
      "label": "Phone",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "address_snapshot",
      "label": "Address Snapshot",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "reason",
      "label": "Reason",
      "fieldtype": "Small Text",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "LC Platform Administrator",
      "read": 1
    },
    {
      "role": "LC Shop Owner",
      "read": 1
    },
    {
      "role": "LC Shop Staff",
      "read": 1
    },
    {
      "role": "LC Customer",
      "read": 1
    }
  ]
}
