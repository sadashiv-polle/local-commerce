{
  "doctype": "DocType",
  "name": "LC Order",
  "module": "Local Commerce",
  "engine": "InnoDB",
  "autoname": "field:request_key",
  "track_changes": 1,
  "field_order": [
    "request_key",
    "shop",
    "customer_user",
    "sales_order",
    "request_hash",
    "status",
    "delivery_user",
    "delivery_note",
    "assigned_at",
    "picked_up_at",
    "delivered_at",
    "payment_method",
    "payment_status",
    "sales_invoice",
    "payment_entry",
    "collected_at",
    "recipient",
    "phone",
    "address_snapshot",
    "destination_latitude",
    "destination_longitude",
    "delivery_distance_km",
    "delivery_instructions",
    "driver_latitude",
    "driver_longitude",
    "driver_location_accuracy",
    "driver_location_at",
    "reason"
  ],
  "fields": [
    {
      "fieldname": "request_key",
      "label": "Request Key",
      "fieldtype": "Data",
      "unique": 1,
      "read_only": 1
    },
    {
      "fieldname": "shop",
      "label": "Shop",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "LC Shop",
      "in_list_view": 1
    },
    {
      "fieldname": "customer_user",
      "label": "Customer User",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "User"
    },
    {
      "fieldname": "sales_order",
      "label": "Sales Order",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Sales Order"
    },
    {
      "fieldname": "request_hash",
      "label": "Request Hash",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "read_only": 1,
      "options": "Requested\nAccepted\nPreparing\nReady\nPicked Up\nOut for Delivery\nDelivered\nCancelled",
      "in_list_view": 1
    },
    {
      "fieldname": "delivery_user",
      "label": "Delivery Person",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "delivery_note",
      "label": "Delivery Note",
      "fieldtype": "Link",
      "options": "Delivery Note",
      "read_only": 1
    },
    {
      "fieldname": "assigned_at",
      "label": "Assigned At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "picked_up_at",
      "label": "Picked Up At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "delivered_at",
      "label": "Delivered At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "payment_method",
      "label": "Payment Method",
      "fieldtype": "Select",
      "options": "Cash on Delivery",
      "read_only": 1
    },
    {
      "fieldname": "payment_status",
      "label": "Payment Status",
      "fieldtype": "Select",
      "options": "Pending\nCollected\nReconciled",
      "read_only": 1
    },
    {
      "fieldname": "sales_invoice",
      "label": "Sales Invoice",
      "fieldtype": "Link",
      "options": "Sales Invoice",
      "read_only": 1
    },
    {
      "fieldname": "payment_entry",
      "label": "Payment Entry",
      "fieldtype": "Link",
      "options": "Payment Entry",
      "read_only": 1
    },
    {
      "fieldname": "collected_at",
      "label": "Collected At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "recipient",
      "label": "Recipient",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "phone",
      "label": "Phone",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "address_snapshot",
      "label": "Address Snapshot",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "destination_latitude",
      "label": "Destination Latitude",
      "fieldtype": "Float",
      "precision": 6,
      "read_only": 1
    },
    {
      "fieldname": "destination_longitude",
      "label": "Destination Longitude",
      "fieldtype": "Float",
      "precision": 6,
      "read_only": 1
    },
    {
      "fieldname": "delivery_distance_km",
      "label": "Straight-line Delivery Distance (km)",
      "fieldtype": "Float",
      "precision": 3,
      "read_only": 1
    },
    {
      "fieldname": "delivery_instructions",
      "label": "Delivery Instructions",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "driver_latitude",
      "label": "Current Driver Latitude",
      "fieldtype": "Float",
      "precision": 6,
      "read_only": 1
    },
    {
      "fieldname": "driver_longitude",
      "label": "Current Driver Longitude",
      "fieldtype": "Float",
      "precision": 6,
      "read_only": 1
    },
    {
      "fieldname": "driver_location_accuracy",
      "label": "Driver Location Accuracy (m)",
      "fieldtype": "Float",
      "read_only": 1
    },
    {
      "fieldname": "driver_location_at",
      "label": "Driver Location At",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "reason",
      "label": "Reason",
      "fieldtype": "Small Text",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "LC Platform Administrator",
      "read": 1
    },
    {
      "role": "LC Shop Owner",
      "read": 1
    },
    {
      "role": "LC Shop Staff",
      "read": 1
    },
    {
      "role": "LC Customer",
      "read": 1
    }
  ]
}
